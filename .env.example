# ==========================================================================
#  Gestione Comande — Configurazione UNICA del deploy Docker
#
#  Copia questo file in ".env" (stessa cartella) e modifica i valori CAMBIAMI:
#      cp .env.example .env
#  Il file ".env" contiene i segreti: NON versionarlo.
#  Dopo ogni modifica riavvia lo stack:  docker compose up -d
# ==========================================================================

# --- Rete / accesso -------------------------------------------------------
# Porta su cui l'app risponde ai tablet:  http://IP-SERVER
APP_PORT=80

# --- Applicazione ---------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
# Chiave di cifratura Laravel. Puoi tenere questa oppure generarne una nuova:
#   docker compose run --rm app php artisan key:generate --show
APP_KEY=base64:HxlVaGOvP4trgAM2ov0pVLqkQAU6SaFpCz+q/46k+kA=
# IP LAN (o hostname) del server — usato dal backend per link/redirect.
APP_URL=http://192.168.1.50
APP_TIMEZONE=Europe/Rome

# --- Database (MariaDB) ---------------------------------------------------
DB_DATABASE=gestione_comande
DB_USERNAME=comande
DB_PASSWORD=CAMBIAMI
DB_ROOT_PASSWORD=CAMBIAMI

# --- WebSocket real-time (Reverb) -----------------------------------------
# REVERB_APP_KEY è pubblica (usata anche dai tablet); REVERB_APP_SECRET è privata.
# NB: se cambi REVERB_APP_KEY, aggiorna anche frontend/.env.production e rifai il build.
REVERB_APP_ID=gestione-comande
REVERB_APP_KEY=comande-key
REVERB_APP_SECRET=CAMBIAMI
