# ==============================================================================
#  CONFIGURAZIONE DI PRODUZIONE — Gestione Comande
#  Copiare in `backend/.env` sul server di produzione e VALORIZZARE i placeholder.
#  NON committare mai questo file una volta compilato con i segreti reali.
#
#  Generazione segreti:
#    APP_KEY            → php artisan key:generate  (oppure: base64:$(openssl rand -base64 32))
#    REVERB_APP_SECRET  → openssl rand -hex 32
#    REVERB_APP_KEY     → openssl rand -hex 16
#    DB_PASSWORD        → openssl rand -base64 24
# ==============================================================================

APP_NAME="Gestione Comande"
APP_ENV=production
APP_KEY=                              # OBBLIGATORIO: php artisan key:generate
APP_DEBUG=false
APP_URL=https://comande.esempio.it    # dominio/IP reale del server in produzione
APP_TIMEZONE=Europe/Rome

# In produzione non esporre debug/stack trace nei log applicativi.
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=gestione_comande
DB_USERNAME=comande
DB_PASSWORD=__CHANGE_ME__STRONG_DB_PASSWORD__

# ── Code / cache / sessioni ───────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Su HTTPS impostare a true: il cookie di sessione viaggia solo cifrato.
SESSION_SECURE_COOKIE=true

# ── Reverb (WebSocket) ────────────────────────────────────────────────────────
# APP_KEY e APP_SECRET DEVONO essere forti e unici per ogni installazione:
# i valori di default (comande-key / comande-secret) NON vanno usati in produzione.
REVERB_APP_ID=gestione-comande
REVERB_APP_KEY=__CHANGE_ME__REVERB_KEY__      # openssl rand -hex 16
REVERB_APP_SECRET=__CHANGE_ME__REVERB_SECRET__ # openssl rand -hex 32
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
# Dietro nginx con TLS il client si connette in wss sulla porta pubblica (443):
# lo scheme lato server resta http (Reverb è interno alla rete Docker).
REVERB_SCHEME=http

# Variabili esposte al build Vite del frontend (devono combaciare con REVERB_*).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Sanctum ───────────────────────────────────────────────────────────────────
# Domini SPA autorizzati: elencare esplicitamente gli host di produzione
# (niente localhost). Separare più domini con la virgola.
SANCTUM_STATEFUL_DOMAINS=comande.esempio.it

# ── KDS (Kitchen Display System) ──────────────────────────────────────────────
# I display KDS non hanno login. Impostare un token forte e configurarlo sui
# display (query "?kds_token=..." o header X-KDS-Token via proxy).
#   KDS_DISPLAY_TOKEN → openssl rand -hex 32
# In alternativa/aggiunta, limitare l'accesso alle sole reti/IP dei display.
KDS_DISPLAY_TOKEN=__CHANGE_ME__KDS_TOKEN__
KDS_TRUSTED_NETWORKS=192.168.0.0/16

# ── Stampa remota (agente Raspberry) ──────────────────────────────────────────
# Su server remoto la stampante non è raggiungibile dal cloud: la stampa passa
# da un agente locale (Raspberry Pi) che fa polling REST. Vedi docs/REMOTE_PRINTING.md.
#   PRINT_AGENT_TOKEN → openssl rand -hex 32 (uno diverso per ogni ristorante/istanza)
PRINT_DRIVER=agent
PRINT_AGENT_TOKEN=__CHANGE_ME__AGENT_TOKEN__
