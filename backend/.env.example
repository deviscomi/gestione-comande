APP_NAME="Gestione Comande"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Rome

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=gestione_comande
DB_USERNAME=comande
DB_PASSWORD=secret

BROADCAST_CONNECTION=reverb
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

REVERB_APP_ID=gestione-comande
REVERB_APP_KEY=comande-key
REVERB_APP_SECRET=comande-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173

# ── Stampa ────────────────────────────────────────────────────────────────
# 'socket' (default, locale): il server stampa via TCP diretto porta 9100.
# 'agent'  (server remoto): un Raspberry locale preleva i job via REST.
PRINT_DRIVER=socket
# Token dell'agente Raspberry (solo modalità 'agent'). Genera: openssl rand -hex 32
PRINT_AGENT_TOKEN=
