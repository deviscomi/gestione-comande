# ── Agente di stampa (Raspberry Pi) ─────────────────────────────────────────
# Copia in ".env" e compila. Un Raspberry per ristorante: punta all'istanza
# di QUEL ristorante e usa il SUO token (PRINT_AGENT_TOKEN del server).

# URL pubblico HTTPS dell'istanza del ristorante (senza slash finale)
SERVER_URL=https://ristorante.esempio.it

# Deve coincidere con PRINT_AGENT_TOKEN impostato sul server di quell'istanza
AGENT_TOKEN=incolla_qui_il_token

# Ogni quanto interrogare il server (ms)
POLL_INTERVAL_MS=2000

# Timeout connessione alla stampante termica (ms)
SOCKET_TIMEOUT_MS=8000

# Ogni quanto inviare l'heartbeat di stato al server (ms). Deve stare abbondante
# sotto PRINT_AGENT_HEARTBEAT_TTL del server (default 90s) per non risultare offline.
HEARTBEAT_INTERVAL_MS=30000
